# 浏览器访问 /dashboard 的基础认证；生产环境未配置时该路由默认返回 404。
DASHBOARD_BASIC_USER=niannian
DASHBOARD_BASIC_PASSWORD=replace-with-a-strong-password

# 念念后端。访问密钥只在 Next.js 服务端读取，不会发送到浏览器。
# 后端部署环境需配置同一个 APP_DASHBOARD_ACCESS_KEY。
MEMO_API_BASE_URL=http://localhost:8080
MEMO_DASHBOARD_KEY=replace-with-dashboard-key

# 仅本地视觉验收使用；生产环境不要开启。
DASHBOARD_USE_MOCK=false

# 仅本地使用的生产汇总快照；优先级高于 Mock，生产环境不要开启。
DASHBOARD_USE_SNAPSHOT=false
DASHBOARD_SNAPSHOT_PATH=.dashboard-data/production-snapshot.json
